{
  "expo": {
    "name": "PrivateCycle",
    "slug": "privatecycle",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/tidemark/production-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncan.privatecycle"
    },
    "android": {
      "package": "com.ncan.privatecycle",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tidemark/production-adaptive-foreground.png",
        "backgroundImage": "./assets/images/tidemark/production-adaptive-background.png",
        "monochromeImage": "./assets/images/tidemark/production-monochrome.png",
        "backgroundColor": "#eae5da"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/tidemark/production-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withAndroidSigning",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "enableRemoteNotifications": false,
          "color": "#e91e63"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ea43c6f-aab8-4618-88e4-137c76e63a21"
      }
    }
  }
}
